rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedCouple() {
      return request.auth != null && (
        request.auth.uid == "UNu6md1mheSrvpClvIULAuMGrSv1" ||
        request.auth.uid == "dTfQHVK7nTaZqi90u3eqcsHNhZd2"
      );
    }

    match /artifacts/{appId}/public/data/{collectionName}/{docId} {
      allow read, write: if isAuthorizedCouple();
    }

    match /transactions/{docId} {
      allow read, write: if isAuthorizedCouple();
    }

    match /households/{houseId}/{document=**} {
      allow read, write: if isAuthorizedCouple();
    }
  }
}